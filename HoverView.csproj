<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>HoverView</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>

    <Company>zes / moonSoir</Company>
    <Product>HoverView</Product>
    <Copyright>Copyright © 2026 zes / moonSoir.</Copyright>
    <Description>Утилита для предпросмотра файлов при наведении в Проводнике Windows.</Description>
    <Version>1.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AnimatedImage.Wpf" Version="2.1.4" />
    <PackageReference Include="SharpCompress" Version="0.50.7" />
  </ItemGroup>

</Project>