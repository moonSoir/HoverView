<Window x:Class="HoverView.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки HoverView" Height="600" Width="520"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Margin="0,0,0,15">
            
            <!-- Вкладка 1: Внешний вид -->
            <TabItem Header="Внешний вид">
                <StackPanel Margin="15">
                    <TextBlock Text="Лимит размера окна предпросмотра" FontWeight="Bold" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Ширина:" VerticalAlignment="Center" Width="70"/>
                        <TextBox x:Name="TxtWidth" Width="80" TextAlignment="Center"/>
                        <TextBlock Text="px" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <TextBlock Text="Высота:" VerticalAlignment="Center" Width="70"/>
                        <TextBox x:Name="TxtHeight" Width="80" TextAlignment="Center"/>
                        <TextBlock Text="px" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </StackPanel>
                    
                    <TextBlock Text="Режим отображения:" FontWeight="Bold" Margin="0,0,0,10"/>
                    <CheckBox x:Name="ChkAutoSizeToContent" 
                              Content="Подстраивать окно точно под размер файла (без рамок)" 
                              Margin="0,0,0,10"/>
                    <CheckBox x:Name="ChkUseMinimalFrame" 
                              Content="Вписывать в лимит с сохранением пропорций и минимальной рамкой" 
                              Margin="0,0,0,20"/>
                    
                    <TextBlock Text="Задержки появления/исчезновения" FontWeight="Bold" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Наведение (мс):" VerticalAlignment="Center" Width="120"/>
                        <TextBox x:Name="TxtHoverDelay" Width="80" TextAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Исчезновение (мс):" VerticalAlignment="Center" Width="120"/>
                        <TextBox x:Name="TxtHideDelay" Width="80" TextAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <!-- Вкладка 2: Форматы и размер -->
            <TabItem Header="Форматы и размер">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">
                        <TextBlock Text="Поддерживаемые форматы (через запятую)" FontWeight="Bold" Margin="0,0,0,10"/>
                        
                        <TextBlock Text="Изображения:" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtImageFormats" Margin="0,0,0,15"/>
                        
                        <TextBlock Text="Видео:" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtVideoFormats" Margin="0,0,0,15"/>

                        <TextBlock Text="Аудио:" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtAudioFormats" Margin="0,0,0,15"/>

                        <TextBlock Text="Текст/Код:" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtTextFormats" Margin="0,0,0,20"/>

                        <TextBlock Text="Максимальный размер файла (МБ, 0 = без ограничений)" FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBox x:Name="TxtMaxSize" Width="100" HorizontalAlignment="Left" TextAlignment="Center" Margin="0,0,0,20"/>

                        <TextBlock Text="Размер кэша изображений (шт.)" FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBox x:Name="TxtMaxCacheSize" Width="100" HorizontalAlignment="Left" TextAlignment="Center"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Вкладка 3: Звук -->
            <TabItem Header="Звук">
                <StackPanel Margin="15">
                    <TextBlock Text="Настройки воспроизведения аудио" FontWeight="Bold" Margin="0,0,0,15"/>
                    
                    <TextBlock Text="Громкость аудиофайлов:" Margin="0,0,0,5"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="SldAudioVolume" Minimum="0" Maximum="100" 
                                TickFrequency="10" IsSnapToTickEnabled="True" 
                                VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="LblAudioVolume" Text="50%" 
                                   VerticalAlignment="Center" Width="50" TextAlignment="Right"/>
                    </Grid>
                    <TextBlock Text="Видео всегда воспроизводится без звука." 
                               Foreground="Gray" FontSize="11" Margin="0,10,0,0"/>
                </StackPanel>
            </TabItem>

            <!-- Вкладка 4: Система -->
            <TabItem Header="Система">
                <StackPanel Margin="15">
                    <TextBlock Text="Запуск приложения" FontWeight="Bold" Margin="0,0,0,10"/>
                    <CheckBox x:Name="ChkAutoStart" Content="Запускать при старте Windows"/>
                </StackPanel>
            </TabItem>

            <!-- Вкладка 5: О программе -->
            <TabItem Header="О программе">
                <StackPanel Margin="15">
                    <TextBlock Text="Информация о приложении" FontWeight="Bold" Margin="0,0,0,10"/>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Версия: "/>
                        <TextBlock x:Name="TxtVersion"/>
                    </StackPanel>
                    
                    <TextBlock x:Name="TxtAuthor" Margin="0,10,0,5"/>
                    <TextBlock x:Name="TxtGitHub" Foreground="DodgerBlue" TextDecorations="Underline" 
                               Cursor="Hand" MouseLeftButtonDown="TxtGitHub_MouseLeftButtonDown"/>
                </StackPanel>
            </TabItem>

        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Сохранить" Width="100" Height="30" Margin="0,0,10,0" 
                    Click="BtnSave_Click" IsDefault="True"/>
            <Button Content="Отмена" Width="100" Height="30" 
                    Click="BtnCancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>